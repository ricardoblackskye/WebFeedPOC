# Stripe Payment Processing
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# Wix API Configuration
VITE_WIX_CLIENT_ID=your_wix_oauth_client_id_here
VITE_WIX_API_KEY=your_wix_api_key_here
VITE_WIX_SITE_ID=your_wix_site_id_here

# Wix Cart Integration (optional - uses localStorage fallback if not configured)
# Default Wix Stores app ID (typically doesn't need to be changed)
VITE_WIX_STORES_APP_ID=1380b703-ce81-ff05-f115-39571d94dfcd

# Wix webhook auto-rebuild (set in Vercel dashboard, not in .env locally)
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxxxx/yyyyy
# WIX_WEBHOOK_SECRET=your_wix_webhook_secret_here
